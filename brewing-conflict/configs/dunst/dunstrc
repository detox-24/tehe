[global]
    geometry = "300x5-20+48"
    transparency = 10
    frame_width = 2
    frame_color = "#6B4C58"
    font = JetBrainsMono Nerd Font 10
    line_height = 4
    padding = 12
    horizontal_padding = 16
    corner_radius = 6
    icon_position = left
    max_icon_size = 48
    separator_height = 2
    separator_color = frame
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left

[urgency_low]
    timeout = 4000
    background = "#2B2425"
    foreground = "#DBC9A8"
    frame_color = "#87586B"

[urgency_normal]
    timeout = 6000
    background = "#010101"
    foreground = "#F3E196"
    frame_color = "#6B4C58"

[urgency_critical]
    timeout = 0
    background = "#544240"
    foreground = "#F3E196"
    frame_color = "#8A683C"
