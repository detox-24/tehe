super + Return
    alacritty

super + space
    rofi -show drun

super + q
    bspc node -c

super + f
    bspc node -t fullscreen

super + t
    bspc node -t ~floating

super + {1-9,0}
    bspc desktop -f '^{1-10}'

super + shift + {1-9,0}
    bspc node -d '^{1-10}'

super + {h,j,k,l}
    bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

super + shift + r
    bspc wm -r

super + shift + q
    bspc quit

XF86AudioRaiseVolume
    amixer -q set Master 5%+

XF86AudioLowerVolume
    amixer -q set Master 5%-

XF86AudioMute
    amixer -q set Master toggle

XF86MonBrightnessUp
    xbacklight -inc 10

XF86MonBrightnessDown
    xbacklight -dec 10

Print
    scrot "$HOME/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"
